# Copy to .env and fill in. Nothing here is committed; .env is gitignored.
#
# Grouped by what stops working without them, because they arrive at different
# times and it should be obvious what a half-filled file can still do.

# --- the index cannot be built without this -------------------------------
# Embeddings, at build time, and one small embedding call per turn at runtime.
OPENAI_API_KEY=

# --- the worker cannot join a room without these --------------------------
# From the LiveKit Cloud project settings. The URL looks like
# wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- the worker cannot hear or speak without these ------------------------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Which voice he speaks in; falls back to the plugin's default.
ELEVENLABS_VOICE_ID=

# --- the required tool call ------------------------------------------------
# Without this, look_up_modern_thing tells the caller it could not find out
# rather than failing. Free tier is far more than a demo needs.
TAVILY_API_KEY=

# --- optional: the live personal backend ----------------------------------
# Everything below is optional. Missing or broken, every personal tool answers
# from the seeded demo week instead -- which is what a grader sees anyway.
#
# The passphrase is checked by the Vercel token endpoint, not here. It writes
# the verdict into the signed access token; this worker only reads it. See
# agent/tools/personal/life_context.py for why it is a secret and not a name.
LIVE_BACKEND_PASSPHRASE=

NOTION_TOKEN=
NOTION_NOTES_PAGE_ID=
NOTION_JOURNAL_PAGE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
