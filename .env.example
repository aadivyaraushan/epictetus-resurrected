# Copy to .env and fill in. Nothing here is committed; .env is gitignored.
#
# Grouped by what stops working without them, because they arrive at different
# times and it should be obvious what a half-filled file can still do.

# --- the index cannot be built without this -------------------------------
# Embeddings at build time, one small embedding call per turn, and one Luna
# summary draft after each completed call.
OPENAI_API_KEY=

# --- the worker cannot join a room without these --------------------------
# From the LiveKit Cloud project settings. The URL looks like
# wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- the worker cannot hear or speak without these ------------------------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Which voice he speaks in; falls back to the plugin's default.
ELEVENLABS_VOICE_ID=

# --- the required tool call ------------------------------------------------
# Without this, look_up_modern_thing tells the caller it could not find out
# rather than failing. Free tier is far more than a demo needs.
TAVILY_API_KEY=

# --- the web app's public Notion connection -------------------------------
# Create a public OAuth integration at developers.notion.com. The redirect URI
# must be this app's /api/notion/callback URL, exactly.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/notion/callback

# A long random value used only to encrypt the HttpOnly same-browser cookie.
# Generate one with: openssl rand -base64 32
NOTION_SESSION_SECRET=

# A separate signing key for the short-lived permit issued when a call starts.
# This keeps the paid summary route unavailable to requests that did not start a call.
REVIEW_SESSION_SECRET=
